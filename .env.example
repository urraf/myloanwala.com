# ============ REQUIRED ============
# MongoDB connection string (MongoDB Atlas or your own server)
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/myloanwala

# Random long secret for login sessions (run: openssl rand -hex 32)
AUTH_SECRET=change-this-to-a-long-random-string

# Your live website URL (used in password-reset emails). Use https:// once SSL is on.
SITE_URL=https://myloanwala.com

# First admin account — created automatically on first login attempt.
# After that, change password from Admin > Account (these values are then ignored).
ADMIN_EMAIL=admin@myloanwala.com
ADMIN_PASSWORD=ChangeMe@123

# ============ AI (blogs + chat assistant) ============
GROQ_API_KEY=
# Optional: a specific Groq model id. Leave empty — the best available model is picked automatically
GROQ_MODEL=
# Free key from https://www.pexels.com/api/ — finds a matching photo for each AI blog
PEXELS_API_KEY=

# ============ EMAIL (forgot password OTP) ============
# Hostinger email: smtp.hostinger.com, port 465
# If left empty, the OTP is printed in the server log (pm2 logs myloanwala).
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM="MyLoanWala <no-reply@myloanwala.com>"

# ============ BRAND (change these to rebrand the whole website) ============
NEXT_PUBLIC_SITE_NAME=MyLoanWala
NEXT_PUBLIC_DOMAIN=myloanwala.com
# Logo — EITHER an image file placed in /public (e.g. /logo.png) ...
NEXT_PUBLIC_LOGO_IMAGE=
# ... OR a two-colour text logo + tagline badge (used when LOGO_IMAGE is empty)
NEXT_PUBLIC_LOGO_TEXT_1=myloan
NEXT_PUBLIC_LOGO_TEXT_2=wala
NEXT_PUBLIC_LOGO_TAGLINE=LOAN HUA AASAN
# Name of the AI chat assistant
NEXT_PUBLIC_BOT_NAME=Loan Mitra

# ============ CONTACT DETAILS shown on website ============
NEXT_PUBLIC_PHONE=+91 98765 43210
# WhatsApp number (optional — defaults to the phone number)
NEXT_PUBLIC_WHATSAPP=
NEXT_PUBLIC_EMAIL=support@myloanwala.com
NEXT_PUBLIC_ADDRESS=New Delhi, India
NEXT_PUBLIC_HOURS=Mon – Sat, 9:30 AM – 7:00 PM

# Where new-lead & new-partner alert emails go (defaults to ADMIN_EMAIL). Needs SMTP above.
LEAD_NOTIFY_EMAIL=

# ============ TESTING ONLY ============
# A fixed OTP that always works for admin password reset. Keep EMPTY on the live server.
DUMMY_OTP=
